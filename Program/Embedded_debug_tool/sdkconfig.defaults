# 性能关键配置（sdkconfig 重建时保持）
CONFIG_LV_DEF_REFR_PERIOD=10
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FPS_STATS=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_ENABLE_EXFAT=y

CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH="/sdcard"
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_FONT_MANAGER=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y

CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y

# 控制台：主 UART0（GPIO43/44，外接 USB-UART 调试）+ 副 USB-Serial/JTAG。
# 读卡器 TinyUSB 接管 USB PHY 时 COM14 静默，但 UART0(COM10) 日志不断
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# USB 读卡器 APP（SD 卡 MSC，esp_tinyusb 组件）
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=2048
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y
CONFIG_TINYUSB_DESC_PRODUCT_STRING="SD Card Reader"

# WiFi 内存收缩（内部 DMA RAM 紧张：显示双缓冲占大头，WiFi 静态缓冲需内部 RAM）
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=4
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
