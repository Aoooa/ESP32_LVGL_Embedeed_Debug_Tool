[Version]
Signature = "$Windows NT$"
Class     = USB
ClassGUID = {36FC9E60-C465-11CF-8056-444553540000}
Provider  = %ProviderName%
CatalogFile=WinUSBCat.cat
DriverVer=06/21/2006,10.0.19041.1

[Manufacturer]
%ProviderName% = WinUSB, NTamd64

[WinUSB.NTamd64]
%USBMyDevice.DeviceDesc% =USB_Install, USB\VID_303A&PID_4010

[USB_Install]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.Services]
Include=winusb.inf
AddService=WinUSB,0x000001fa,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName     = %WinUSB_SvcDesc%
ServiceType     = 1
StartType       = 3
ErrorControl    = 1
ServiceBinary   = %12%\WinUSB.sys

[USB_Install.Wdf]
KmdfService=WINUSB, WinUsb_Install

[WinUSB_Install]
KmdfLibraryVersion=1.11

[USB_Install.HW]
AddReg=Dev_AddReg

[Dev_AddReg]
HKR,,DeviceType,,0x00000007
HKR,,DevicePathType,,0x00000002

[Strings]
ProviderName="ESP32_DIY"
WinUSB_SvcDesc="WinUSB - Kernel Driver"
USB\MyDevice.DeviceDesc="ESP32 USB Display WinUSB"